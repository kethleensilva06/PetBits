# Modelo de configuração do PetBits.
# Copie para .env e preencha. O .env não é versionado (veja .gitignore).

# Base URL do API group do domínio, copiado do painel do Xano.
# Formato: https://<instancia>.<regiao>.xano.io/api:<id-do-api-group>
XANO_BASE_URL=

# Base URL do API group de autenticação. É outro endereço: esse grupo vem
# pronto no workspace do Xano e mora em um api: diferente do grupo acima.
XANO_AUTH_BASE_URL=
