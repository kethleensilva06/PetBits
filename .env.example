# Modelo de configuração do PetBits.
# Copie este arquivo para .env e preencha com os dados do seu workspace Xano.
# O .env não é versionado (veja .gitignore).

# Base URL do API group PetBits (as 9 tabelas + o cadastro de tutor).
# Formato: https://<workspace>.<regiao>.xano.io/api:<id-do-api-group>
XANO_BASE_URL=

# Base URL do API group Authentication (login e auth/me). É outro endereço:
# esse grupo vem pronto no workspace do Xano e mora em um api: diferente.
XANO_AUTH_BASE_URL=

# Token da Metadata API. Só é usado por scripts/promover_admin.py, para
# transformar uma conta em administradora da clínica. A aplicação não precisa
# dele — o token de cada pessoa nasce no login. Gere em Settings ->
# Metadata API, no painel do Xano, e apague daqui quando não precisar mais:
# ele dá acesso total ao workspace e vence em poucos dias.
XANO_META_TOKEN=
